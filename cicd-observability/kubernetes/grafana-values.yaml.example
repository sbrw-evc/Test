# Values for the grafana/grafana chart, or under grafana: in kube-prometheus-stack.
# Merge with your existing values; not a replacement for the full release.
plugins:
  - yesoreyeram-infinity-datasource 4.1.1
envFromSecret: cicd-grafana-api
extraConfigmapMounts:
  - name: cicd-datasources
    mountPath: /etc/grafana/provisioning/datasources/cicd.yaml
    subPath: cicd.yaml
    configMap: cicd-datasources
    readOnly: true
  - name: cicd-dashboard-provider
    mountPath: /etc/grafana/provisioning/dashboards/cicd.yaml
    subPath: cicd.yaml
    configMap: cicd-dashboard-provider
    readOnly: true
  - name: cicd-dashboard-json
    mountPath: /var/lib/grafana/dashboards/cicd
    configMap: cicd-dashboard-json
    readOnly: true
  - name: cicd-alert-rules
    mountPath: /etc/grafana/provisioning/alerting/cicd-rules.yaml
    subPath: rules.yaml
    configMap: cicd-alert-rules
    readOnly: true
# Optional notifications: mount notifications.yaml AFTER merging existing routes.
