      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{env=~\"$env\",component=~\"$component\",job=\"cicd-http\"} and (time()-timestamp(probe_duration_seconds{env=~\"$env\",component=~\"$component\",job=\"cicd-http\"}) < 90)",
