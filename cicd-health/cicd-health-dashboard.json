    {
      "id": 12,
      "title": "Длительность последней операции",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "description": "Ступенчатое значение последней завершённой операции, не p95 и не распределение всех запусков.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ci_last_operation_duration_seconds{env=~\"$env\",component=~\"$component\",project=~\"$project\"} and on (env, component) (ci:data_stale == 0) and on (env, component) (ci:component_available == 1)",
          "legendFormat": "{{component}} / {{pipeline}}",
          "instant": false,
          "range": true,
          "format": "time_series",
